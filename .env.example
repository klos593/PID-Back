# Copy to .env for local (non-Docker) runs. In Docker, these are set via
# docker-compose.dev.yml / the production compose file instead.

DATABASE_URL=postgresql://appuser:devpassword@127.0.0.1:5432/appdb

# Secret used to sign session/CSRF cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Never commit a real value.
COOKIE_SECRET=replace-with-a-random-32-char-minimum-secret
